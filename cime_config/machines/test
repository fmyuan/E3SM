<machine MACH="cades">
    <DESC>OR-CONDO, CADES-CCSI, os is Linux, 16 pesx2HThreads/nodes, batch system is Slurm</DESC>
    <NODENAME_REGEX>pflogin</NODENAME_REGEX>
    <OS>LINUX</OS>
    <COMPILERS>gnu</COMPILERS>
    <MPILIBS>openmpi,mpi-serial</MPILIBS>
    <CIME_OUTPUT_ROOT>/projects/hpcl-cli185/users/$USER</CIME_OUTPUT_ROOT>
    <DIN_LOC_ROOT>/projects/hpcl-cli185/world-shared/e3sm/inputdata</DIN_LOC_ROOT>
    <DIN_LOC_ROOT_CLMFORC>/projects/hpcl-cli185/world-shared/e3sm/atm/datm7</DIN_LOC_ROOT_CLMFORC>
    <DOUT_S_ROOT>$CIME_OUTPUT_ROOT/archive/$CASE</DOUT_S_ROOT>
    <BASELINE_ROOT>/projects/hpcl-cli185/proj-shared/e3sm/baselines/$COMPILER</BASELINE_ROOT>
    <CCSM_CPRNC>/projects/hpcl-cli185/proj-shared/tools/cprnc</CCSM_CPRNC>
    <GMAKE_J>4</GMAKE_J>
    <TESTS>e3sm_developer</TESTS>
    <BATCH_SYSTEM>slurm</BATCH_SYSTEM>
    <SUPPORTED_BY>yuanf -at- ornl.gov</SUPPORTED_BY>
    <MAX_TASKS_PER_NODE>128</MAX_TASKS_PER_NODE>
    <MAX_MPITASKS_PER_NODE>128</MAX_MPITASKS_PER_NODE>
    <PROJECT_REQUIRED>FALSE</PROJECT_REQUIRED>
    <mpirun mpilib="openmpi" compiler="gnu">
      <executable>srun</executable>
      <arguments>
        <arg name="num_tasks"> -n {{ total_tasks }}</arg>
      </arguments>
    </mpirun>
    <!-- mpirun mpilib="mpi-serial">
      <executable> </executable>
    </mpirun -->
    <module_system type="module" allow_error="true">
      <init_path lang="sh">/sw/cades-open/lmod/8.7.55/init/sh</init_path>
      <init_path lang="csh">/sw/cades-open/lmod/8.7.55/init/csh</init_path>
      <init_path lang="perl">/sw/cades-open/lmod/8.7.55/init/perl</init_path>
      <init_path lang="python">/sw/cades-open/lmod/8.7.55/init/env_modules_python.py</init_path>
      <cmd_path lang="sh"></cmd_path>
      <cmd_path lang="csh"></cmd_path>
      <cmd_path lang="perl"></cmd_path>
      <cmd_path lang="python">/sw/cades-open/lmod/8.7.55/libexec/lmod python</cmd_path>
      <modules>
        <command name="purge"/>
      </modules>
      <!-- modules compiler="gnu" mpilib="mpi-serial">
        <command name="load">gcc/12.2.0</command>
        <command name="load">python/3.10.14</command>
        <command name="load">cmake/3.24.4</command>
        <command name="load">openblas/0.3.26</command>
        <command name="load">hdf5/1.14.3</command>
      </modules -->
      <modules compiler="gnu" mpilib="openmpi">
        <command name="load">DefApps</command>
        <command name="load">openblas/0.3.26</command>
        <command name="load">wget/1.21.3</command>
        <command name="load">cmake/3.24.4</command>
        <command name="load">python/3.10.14</command>
        <command name="load">hdf5/1.14.3-mpi</command>
        <command name="load">netcdf-c/4.9.2-mpi-h5f</command>
        <command name="load">netcdf-fortran/4.6.1-mpi-h5f</command>
        <command name="load">parallel-netcdf/1.12.3-mpi</command>
      </modules>
    </module_system>
    <RUNDIR>$CIME_OUTPUT_ROOT/$CASE/run</RUNDIR>
    <EXEROOT>$CIME_OUTPUT_ROOT/$CASE/bld</EXEROOT>
    <environment_variables compiler="gnu" mpilib="openmpi">
      <env name="HDF5_PATH">$ENV{OLCF_HDF5_ROOT}</env>
      <env name="NETCDF_PATH">$ENV{OLCF_NETCDF_C_ROOT}</env>
      <env name="NETCDF_C_PATH">$ENV{OLCF_NETCDF_C_ROOT}</env>
      <env name="NETCDF_FORTRAN_PATH">$ENV{OLCF_NETCDF_FORTRAN_ROOT}</env>
      <env name="PNETCDF_PATH">$ENV{OLCF_PARALLEL_NETCDF_ROOT}</env>
      <env name="BLASLAPACK_LIBDIR">$ENV{OLCF_OPENBLAS_ROOT}/lib</env>
      <env name="PERL5LIB">/home/f9y/perl5/lib/perl5</env>
      <env name="PETSC_PATH">/home/f9y/devtools/petsc-x</env>
    </environment_variables>
    <!-- environment_variables compiler="gnu" mpilib="mpi-serial">
      <env name="HDF5_PATH"></env>
      <env name="NETCDF_PATH"></env>
      <env name="NETCDF_C_PATH"></env>
      <env name="NETCDF_FORTRAN_PATH"></env>
      <env name="BLASLAPACK_LIBDIR">$ENV{OLCF_OPENBLAS_ROOT}/lib</env>
      <env name="PERL5LIB">/home/f9y/perl5/lib/perl5</env>
    </environment_variables -->
  </machine>
