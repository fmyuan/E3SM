if (CMAKE_C_COMPILER_ID MATCHES "GNU")
  set(SCC "gcc")
  set(SCXX "g++")
else()
  set(SCC "clang")
  set(SCXX "clang++")
endif()
set(CXX_LINKER "CXX")
string(APPEND CMAKE_C_FLAGS " -DNETCDF_ENABLE_LEGACY_MACROS")
string(APPEND CMAKE_EXE_LINKER_FLAGS " -Wl,-rpath,$ENV{FC_ROOT}/lib")
set(ALQUIMIA_DIR $ENV{ALQUIMIA_DIR})
set(PFLOTRAN_DIR $ENV{PFLOTRAN_DIR})
set(PETSC_DIR $ENV{PETSC_DIR})
if (ALQUIMIA_DIR AND PFLOTRAN_DIR AND PETSC_DIR)
  if (COMP_NAME STREQUAL "elm")
    string(APPEND CPPDEFS " -DUSE_ALQUIMIA_LIB")
    string(APPEND CMAKE_C_FLAGS " -I${ALQUIMIA_DIR}/include")
    string(APPEND CMAKE_CXX_FLAGS " -I${ALQUIMIA_DIR}/include")
    string(APPEND CMAKE_Fortran_FLAGS " -I${ALQUIMIA_DIR}/include -I${PFLOTRAN_DIR} -I${PETSC_DIR}/include")
  endif()
  if (COMP_NAME STREQUAL "cpl")
    string(APPEND CMAKE_EXE_LINKER_FLAGS " -Wl,-rpath,${ALQUIMIA_DIR}/lib -L${ALQUIMIA_DIR}/lib -lalquimia")
    string(APPEND CMAKE_EXE_LINKER_FLAGS " -Wl,-rpath,${PFLOTRAN_DIR} -L${PFLOTRAN_DIR} -lpflotranchem")
    string(APPEND CMAKE_EXE_LINKER_FLAGS " -Wl,-rpath,${PETSC_DIR}/lib -L${PETSC_DIR}/lib -lpetsc")
  endif()
endif()
