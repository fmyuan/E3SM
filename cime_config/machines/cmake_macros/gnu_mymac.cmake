set(CXX_LINKER "CXX")
string(APPEND CMAKE_C_FLAGS " -DNETCDF_ENABLE_LEGACY_MACROS")
string(APPEND CMAKE_EXE_LINKER_FLAGS " -Wl,-rpath,$ENV{FC_ROOT}/lib")
set(ALQUIMIA_PATH $ENV{ALQUIMIA_PATH})
set(PFLOTRAN_PATH $ENV{PFLOTRAN_PATH})
if (ALQUIMIA_PATH AND PFLOTRAN_PATH)
  if (COMP_NAME STREQUAL "elm")
    string(APPEND CPPDEFS " -DELM_USE_ALQUIMIA")
    string(APPEND CMAKE_C_FLAGS " -I${ALQUIMIA_PATH}/include")
    string(APPEND CMAKE_CXX_FLAGS " -I${ALQUIMIA_PATH}/include")
    string(APPEND CMAKE_Fortran_FLAGS " -I${ALQUIMIA_PATH}/include")
  endif()
  if (COMP_NAME STREQUAL "cpl")
    string(APPEND CMAKE_EXE_LINKER_FLAGS " -Wl,-rpath,${ALQUIMIA_PATH}/lib -L${ALQUIMIA_PATH}/lib -lalquimia")
  endif()
endif()
